# Vercel runs bundled Chromium by default; no browser key is required.
# Local macOS/Windows development only: path to installed Chrome.
CHROME_EXECUTABLE_PATH=
# Optional override: remote Chromium CDP WebSocket URL.
BROWSER_WS_ENDPOINT=
# Optional: existing commercial HTML rendering fallback.
SCRAPER_PROVIDER=
SCRAPER_API_KEY=
# Server-side WebBridge command endpoint.
WEBBRIDGE_URL=http://172.104.164.40:10086/command
# Supabase server-only credentials. Never prefix the service-role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
